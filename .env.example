# Public site address, used for canonical URLs, sitemap and social previews.
# Required at build time. No trailing slash. Placeholder hosts such as example.com are rejected.
# Local preview: http://localhost:4173
NEXT_PUBLIC_SITE_URL=

# Cloudflare Pages Function (functions/api/enquiry.ts). Set these in the Pages project settings, not here.
# RESEND_API_KEY=
# ENQUIRY_TO=            address that receives enquiries
# ENQUIRY_FROM=          verified sender, e.g. "CM Timberhaus <enquiries@yourdomain>"
